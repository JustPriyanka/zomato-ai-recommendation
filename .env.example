# API Keys
GROQ_API_KEY=your_groq_api_key_here

# App Configuration
GROQ_MODEL=llama-3.3-70b-versatile
MAX_CANDIDATES=20
TOP_K=5
CACHE_DIR=data/cache
LOG_LEVEL=INFO

# CORS — set to your Vercel frontend URL(s) when deploying to Railway
# Comma-separated if multiple origins needed
# Example: ALLOWED_ORIGINS=https://your-app.vercel.app
ALLOWED_ORIGINS=
